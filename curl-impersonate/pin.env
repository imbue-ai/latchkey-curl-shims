# The upstream curl-impersonate we build and ship. .github/workflows/release.yml
# clones this exact commit and builds it from source on every release leg.
#
# To bump: change UPSTREAM_TAG and UPSTREAM_COMMIT together (the tag alone
# can move). Read the diff of upstream's patches/ between the two tags
# first: that is the whole delta over stock curl and BoringSSL. Then bump
# the version in Cargo.toml and tag a release (README.md, "Bumping the
# upstream pin").
UPSTREAM_TAG=v2.2.2
UPSTREAM_COMMIT=107d67f9f7a518334b1b11e4810637e70b2671a7
